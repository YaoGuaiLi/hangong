{
  "name": "hangong",
  "version": "1.3.0",
  "description": "汉宫 (Han Gong) · magpie gateway middleware + control page: put a full workbench system prompt on every request, in each protocol's own system-prompt place — one injection point for every agent. 网关系统提示词中间件 + 原生控制台页面",
  "type": "module",
  "files": [
    "hangong.middleware.js",
    "hangong-prompt.js",
    "README.md",
    "LICENSE",
    "cases.json",
    "hangong.test.mjs",
    "assets/hangong-prompt.md",
    "scripts/build-prompt.mjs",
    "assets/icon.svg",
    "docs/architecture.svg",
    "docs/sequence.svg",
    "scripts/render-diagrams.mjs",
    "page/",
    "prompts/",
    "page/agents.js"
  ],
  "keywords": [
    "magpie",
    "magpie-plugin",
    "magpie-middleware",
    "system-prompt",
    "opencode",
    "opencode-plugin",
    "llm-gateway",
    "prompt"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YaoGuaiLi/hangong.git"
  },
  "magpie": {
    "middleware": "./hangong.middleware.js",
    "options": {
      "override": true,
      "position": "prepend"
    },
    "icon": "data:image/svg+xml;base64,",
    "page": {
      "title": "Han Gong",
      "titles": {
        "en": "Han Gong",
        "zh": "汉宫",
        "zh-TW": "漢宮",
        "ja": "漢宮"
      },
      "file": "page/index.html",
      "icon": "assets/icon.svg"
    }
  },
  "scripts": {
    "test": "node hangong.test.mjs",
    "build": "node scripts/build-prompt.mjs"
  }
}
