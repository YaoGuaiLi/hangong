[
  { "name": "Anthropic: no system prompt is given this one",
    "options": { "on_prompt": "P." },
    "request": { "model": "m", "messages": [] },
    "expect_request": { "model": "m", "messages": [], "system": "P." } },
  { "name": "Anthropic: override prepends to a string (default position)",
    "options": { "on_prompt": "P.", "override": true },
    "request": { "model": "m", "system": "You code." },
    "expect_request": { "model": "m", "system": "P.\nYou code." } },
  { "name": "Anthropic: position append goes after the agent's own",
    "options": { "on_prompt": "P.", "override": true, "position": "append" },
    "request": { "model": "m", "system": "You code." },
    "expect_request": { "model": "m", "system": "You code.\nP." } },
  { "name": "Anthropic: without override the agent's own stays",
    "options": { "on_prompt": "P.", "override": false },
    "request": { "model": "m", "system": "You code." } },
  { "name": "Anthropic: array system gets a block in front",
    "options": { "on_prompt": "P." },
    "request": { "model": "m", "system": [{ "type": "text", "text": "You code." }] },
    "expect_request": { "model": "m", "system": [{ "type": "text", "text": "P." }, { "type": "text", "text": "You code." }] } },
  { "name": "Chat: a request without a system message gets one",
    "ctx": { "protocol": "chat" },
    "options": { "on_prompt": "P." },
    "request": { "model": "m", "messages": [{ "role": "user", "content": "hi" }] },
    "expect_request": { "model": "m", "messages": [{ "role": "system", "content": "P." }, { "role": "user", "content": "hi" }] } },
  { "name": "Chat: override prepends into a developer message",
    "ctx": { "protocol": "chat" },
    "options": { "on_prompt": "P.", "override": true },
    "request": { "model": "m", "messages": [{ "role": "developer", "content": "You code." }, { "role": "user", "content": "hi" }] },
    "expect_request": { "model": "m", "messages": [{ "role": "developer", "content": "P.\nYou code." }, { "role": "user", "content": "hi" }] } },
  { "name": "Chat: developer message with a parts array",
    "ctx": { "protocol": "chat" },
    "options": { "on_prompt": "P.", "override": true, "position": "append" },
    "request": { "model": "m", "messages": [{ "role": "developer", "content": [{ "type": "text", "text": "You code." }] }] },
    "expect_request": { "model": "m", "messages": [{ "role": "developer", "content": [{ "type": "text", "text": "You code." }, { "type": "text", "text": "P." }] }] } },
  { "name": "Responses: no instructions gets them",
    "ctx": { "protocol": "responses" },
    "options": { "on_prompt": "P." },
    "request": { "model": "m", "input": [] },
    "expect_request": { "model": "m", "input": [], "instructions": "P." } },
  { "name": "Responses: override prepends to instructions",
    "ctx": { "protocol": "responses" },
    "options": { "on_prompt": "P.", "override": true },
    "request": { "model": "m", "instructions": "You code.", "input": [] },
    "expect_request": { "model": "m", "instructions": "P.\nYou code.", "input": [] } },
  { "name": "Gemini: systemInstruction parts get one in front",
    "ctx": { "protocol": "gemini" },
    "options": { "on_prompt": "P." },
    "request": { "model": "m", "systemInstruction": { "parts": [{ "text": "You code." }] } },
    "expect_request": { "model": "m", "systemInstruction": { "parts": [{ "text": "P." }, { "text": "You code." }] } } },
  { "name": "Gemini: snake_case system_instruction is honoured too",
    "ctx": { "protocol": "gemini" },
    "options": { "on_prompt": "P." },
    "request": { "model": "m", "system_instruction": { "parts": [{ "text": "You code." }] } },
    "expect_request": { "model": "m", "system_instruction": { "parts": [{ "text": "P." }, { "text": "You code." }] } } },
  { "name": "agents filter: other agents are left alone",
    "ctx": { "agent": "codex" },
    "options": { "on_prompt": "P.", "agents": ["claude"] },
    "request": { "model": "m", "messages": [] } },
  { "name": "models filter: matches by name prefix",
    "ctx": { "model": "glm-5.3" },
    "options": { "on_prompt": "P.", "models": ["glm-"] },
    "request": { "model": "glm-5.3", "messages": [] },
    "expect_request": { "model": "glm-5.3", "messages": [], "system": "P." } },
  { "name": "models filter: no match, no touch",
    "ctx": { "model": "deepseek" },
    "options": { "on_prompt": "P.", "models": ["glm-"] },
    "request": { "model": "deepseek", "messages": [] } }
]
